# Configuration placeholders only. Load explicitly; no dotenv dependency.
PORT=4317
# ASMR_DATA_DIR=/path/to/private/application-data
ASMR_MAX_UPLOAD_BYTES=268435456
ASMR_DECODED_BUDGET_BYTES=536870912
ASMR_ACCEPTED_FORMATS=wav,flac,mp3,ogg,m4a
# For a local Vite frontend reverse proxy, PORT=4319 and
# ASMR_ALLOWED_ORIGIN=http://127.0.0.1:4318 (still loopback-only).
# ASMR_ALLOWED_ORIGIN=http://127.0.0.1:4318
